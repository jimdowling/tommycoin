APP_NAME="TommyCoin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tommycoin
# DB_USERNAME=root
# DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MAIL_MAILER=log
MAIL_FROM_ADDRESS="tommy@tommycoin.io"
MAIL_FROM_NAME="Tommy (of TommyCoin)"

# Stripe — get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... / pk_test_... for testing, sk_live_... / pk_live_... for production
STRIPE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET=sk_test_your_secret_key_here
# Get this after registering the webhook endpoint in the Stripe dashboard
# Endpoint URL: https://your-domain.koyeb.app/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
